<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\projectaccel.ico</ApplicationIcon>

    <AssemblyName>ProjectAccel</AssemblyName>
    <RootNamespace>ProjectAccel.App</RootNamespace>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0-dev</InformationalVersion>
    <Product>ProjectAccel</Product>
    <Company>ProjectAccel</Company>
    <Description>Mouse acceleration, reimagined. Native Windows host (WebView2) + React UI for ProjectAccel.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProjectAccel.Core\ProjectAccel.Core.csproj" />
    <ProjectReference Include="..\ProjectAccel.Backend\ProjectAccel.Backend.csproj" />
  </ItemGroup>

  <!-- Build da UI em web/dist é copiado para <output>/wwwroot.
       Gere-o com: cd web && npm ci && npm run build -->
  <ItemGroup>
    <Content Include="..\..\web\dist\**\*.*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
