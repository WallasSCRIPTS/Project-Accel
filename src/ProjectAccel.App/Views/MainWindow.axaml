<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectAccel.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1120" d:DesignHeight="680"
        x:Class="ProjectAccel.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/projectaccel-mark.png"
        Title="ProjectAccel"
        Width="1120" Height="680"
        MinWidth="980" MinHeight="620"
        Background="{DynamicResource AppBackground}">

    <Grid ColumnDefinitions="272,*">

        <!-- ══════════ SIDEBAR ══════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource SidebarStroke}"
                BorderThickness="0,0,1,0"
                Padding="22,20,22,16">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="/Assets/projectaccel-mark.png" Width="46" Height="46" />
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="ProjectAccel" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <Border Background="{DynamicResource AccentCyanDim}" CornerRadius="4"
                                HorizontalAlignment="Left" Padding="6,1">
                            <TextBlock Text="{Binding VersionChip}" FontSize="10" FontWeight="Medium"
                                       Foreground="{DynamicResource AccentCyan}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- nav -->
                <StackPanel Grid.Row="1" Spacing="2" Margin="0,30,0,0">
                    <TextBlock Text="NAVEGAÇÃO" FontSize="10" FontWeight="Medium" LetterSpacing="2"
                               Foreground="{DynamicResource TextFaint}" Margin="12,0,0,8" />

                    <!-- ativo -->
                    <Border Background="{DynamicResource NavItemActive}" CornerRadius="8"
                            BorderBrush="{DynamicResource AccentEmber}" BorderThickness="3,0,0,0"
                            Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentEmber}" VerticalAlignment="Center" />
                            <TextBlock Text="Painel" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- em breve -->
                    <Border Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                            <TextBlock Text="Editor de Curvas" FontSize="13.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="breve" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="6,1,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                            <TextBlock Text="Perfis" FontSize="13.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="breve" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="6,1,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                            <TextBlock Text="Dispositivos" FontSize="13.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="breve" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="6,1,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Padding="10,9">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                            <TextBlock Text="Ajustes" FontSize="13.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="breve" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="6,1,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- status -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <Border Height="1" Background="{DynamicResource CardStroke}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentCyan}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BackendStatus}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentAmber}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DriverStatus}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Aplicar configs reais chega na Fase 2 (driver KMDF)"
                               FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="16,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ CONTEÚDO ══════════ -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="20" Margin="44,28">

                <Image Source="/Assets/projectaccel-badge.png" Width="300" Stretch="Uniform"
                       HorizontalAlignment="Left" />

                <TextBlock Text="MOUSE ACCELERATION, REIMAGINED." FontSize="10.5" FontWeight="Medium"
                           LetterSpacing="3" Foreground="{DynamicResource AccentAmber}" />

                <TextBlock FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap" LineHeight="37">
                    <Run Text="Acelere o cursor no nível do driver," />
                    <LineBreak />
                    <Run Text="com um visual à altura." Foreground="{DynamicResource TextSecondary}" />
                </TextBlock>

                <TextBlock FontSize="13" LineHeight="20" Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap" MaxWidth="640">
                    Curvas de aceleração ao vivo, perfis por jogo e migração direta do settings.json do RawAccel.
                    Este é o scaffold da Fase 0 — a base está pronta para a Fase 1 (simulador completo) e para o
                    driver KMDF próprio (Fase 2).
                </TextBlock>

                <!-- pilares -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,4,0,0">
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <StackPanel Spacing="7">
                            <TextBlock Text="01 · Curvas próprias" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentAmber}" />
                            <TextBlock Text="Motor matemático limpo, sem o legado WinForms — curvas animadas via ScottPlot."
                                       FontSize="11" LineHeight="17" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <StackPanel Spacing="7">
                            <TextBlock Text="02 · Driver KMDF" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentEmber}" />
                            <TextBlock Text="Upper filter no mouse class, IOCTLs próprios em \\.\projectaccel — assinado para release."
                                       FontSize="11" LineHeight="17" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <StackPanel Spacing="7">
                            <TextBlock Text="03 · Anti-abuso" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentCyan}" />
                            <TextBlock Text="Delay de 1s na aplicação e fórmulas congeladas por versão — a postura anti-cheat do RawAccel, preservada."
                                       FontSize="11" LineHeight="17" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ações -->
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,6,0,0">
                    <Button Content="Abrir o plano do projeto →"
                            Click="OpenPlan_Click"
                            Background="{DynamicResource AccentEmber}"
                            Foreground="{DynamicResource AccentEmberText}"
                            FontWeight="SemiBold" FontSize="13"
                            Padding="16,9" CornerRadius="8" />
                    <Button Content="Ver o README"
                            Click="OpenReadme_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondary}"
                            FontSize="13" Padding="12,9" CornerRadius="8"
                            BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" />
                </StackPanel>

                <TextBlock Text="{Binding FooterNote}" FontSize="10"
                           Foreground="{DynamicResource TextFaint}" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
